# Copy to server/.env. Relay picks a provider automatically from whatever
# credentials are present, in this order: Bedrock -> Anthropic -> OpenAI -> scripted.
# With nothing set at all it still runs, fully offline, on the scripted engine.

# --- Provider ----------------------------------------------------------------
# auto | bedrock | anthropic | openai | scripted
LLM_PROVIDER=auto

# --- Amazon Bedrock (the AWS-native path; needs model access enabled) --------
# Either a Bedrock API key from the console (easiest for a hackathon)...
AWS_BEDROCK_API_KEY=
# ...or standard AWS credentials / a named profile.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_PROFILE=
AWS_REGION=us-west-2
# Confirm these ids in Bedrock console -> Model access; they vary by account.
BEDROCK_FAST_MODEL=global.anthropic.claude-haiku-4-5
BEDROCK_SMART_MODEL=global.anthropic.claude-sonnet-4-6

# --- Direct providers (work today, before Bedrock is switched on) ------------
ANTHROPIC_API_KEY=
ANTHROPIC_FAST_MODEL=claude-haiku-4-5
ANTHROPIC_SMART_MODEL=claude-opus-5

OPENAI_API_KEY=
OPENAI_FAST_MODEL=gpt-4o-mini
OPENAI_SMART_MODEL=gpt-4o

# --- AgentCore Memory (optional; needs `pip install bedrock-agentcore`) ------
# Leave blank to use the local JSON store. The learning behaviour is identical.
AGENTCORE_MEMORY_ID=
RELAY_MEMORY_PATH=.relay-memory.json

PORT=8787
